{
  "identifier": "topic_tags",
  "scope_class": "global",
  "description": "Editorial topic tags",
  "prompt": "A list of short lowercase tags, no duplicates, at most 10.",
  "model": "gemini-3.5-flash",
  "notes": "The schema defines an array with a limit of 10 unique items. Each item is validated as a lowercase string containing alphanumeric characters, hyphens, or underscores, with a reasonable maximum length of 50 characters to keep them short.",
