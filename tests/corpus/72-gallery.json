        "cover"
      ],
      "type": "object"
    },
    "items": {
      "properties": {
        "alt": {
          "description": "Alternative text describing the image for accessibility.",
          "type": "string"
        },
        "cover": {
          "description": "Set to true if this image is the cover photo for the gallery.",
          "type": "boolean"
        },
        "url": {
          "description": "The direct URL of the image.",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "url",
        "alt"
      ],
      "type": "object"
    },
    "type": "array"
  },
