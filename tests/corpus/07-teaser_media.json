{
  "identifier": "teaser_media",
  "scope_class": "global",
  "description": "Teaser media for front pages",
  "prompt": "Either an image (kind, url, alt text) or a video (kind, url, duration in seconds). The kind field distinguishes the two.",
  "model": "gemini-3.5-flash",
  "notes": "We use a `oneOf` block to separate validation rules for images and videos based on the value of the `kind` property. The `uri` format is used to validate the URL, and `additionalProperties: false` is safe to use here since the schema defines closed property sets for both media types.",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "alt": {
            "type": "string"
          },
          "kind": {
            "const": "image",
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "url",
          "alt"
        ]
      },
      {
        "additionalProperties": false,
        "properties": {
          "duration": {
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "const": "video",
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "url",
          "duration"
        ]
      }
    ],
    "type": "object"
  },
  "suspected_gaps": [
    "additionalProperties(false)",
    "format:uri"
  ],
  "evaluation": {
    "samples": 1000,
    "generation_errors": 0,
    "invalid_samples": 0,
    "generation_error_examples": [],
    "invalid_examples": []
  }
}
