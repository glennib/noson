{
  "identifier": "teaser_media",
  "scope_class": "global",
  "description": "Teaser media for front pages",
  "prompt": "Either an image (kind, url, alt text) or a video (kind, url, duration in seconds). The kind field distinguishes the two.",
  "model": "gemini-3.5-flash",
  "notes": "We use a `oneOf` block to separate validation rules for images and videos based on the value of the `kind` property. The `uri` format is used to validate the URL, and `additionalProperties: false` is safe to use here since the schema defines closed property sets for both media types.",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "alt": {
            "type": "string"
          },
          "kind": {
            "const": "image",
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "url",
          "alt"
        ]
      },
      {
        "additionalProperties": false,
        "properties": {
          "duration": {
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "const": "video",
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "url",
          "duration"
        ]
      }
    ],
    "type": "object"
  },
  "suspected_gaps": [
    "additionalProperties(false)",
    "format:uri"
  ],
  "evaluation": {
    "samples": 100,
    "generation_errors": 0,
    "invalid_samples": 100,
    "generation_error_examples": [],
    "invalid_examples": [
      {
        "seed": 0,
        "value": {
          "duration": 56,
          "kind": "video",
          "url": "zBql3QHx"
        },
        "errors": [
          {
            "message": "{\"duration\":56,\"kind\":\"video\",\"url\":\"zBql3QHx\"} is not valid under any of the schemas listed in the 'oneOf' keyword",
            "instance_path": "",
            "schema_path": "/oneOf"
          }
        ]
      },
      {
        "seed": 1,
        "value": {
          "duration": 80,
          "kind": "video",
          "url": "MbNLxQh"
        },
        "errors": [
          {
            "message": "{\"duration\":80,\"kind\":\"video\",\"url\":\"MbNLxQh\"} is not valid under any of the schemas listed in the 'oneOf' keyword",
            "instance_path": "",
            "schema_path": "/oneOf"
          }
        ]
      },
      {
        "seed": 2,
        "value": {
          "alt": "7BR",
          "kind": "image",
          "url": "ifYMr"
        },
        "errors": [
          {
            "message": "{\"alt\":\"7BR\",\"kind\":\"image\",\"url\":\"ifYMr\"} is not valid under any of the schemas listed in the 'oneOf' keyword",
            "instance_path": "",
            "schema_path": "/oneOf"
          }
        ]
      }
    ]
  }
}
