{
  "identifier": "related_content",
  "scope_class": "global",
  "description": "Related content ids",
  "prompt": "1-20 unique content ids. Ids look like acme:article:12345.",
  "model": "gemini-3.5-flash",
  "notes": "The schema ensures the attribute is an array containing between 1 and 20 unique strings. A regex pattern is used to validate the 'namespace:type:id' structure, ensuring the final segment is numeric as shown in the operator's example.",
