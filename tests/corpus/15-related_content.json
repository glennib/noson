    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
      "pattern": "^[a-zA-Z0-9_-]+:[a-zA-Z0-9_-]+:[0-9]+$",
      "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
  },
  "suspected_gaps": [
    "pattern",
    "uniqueItems"
  ],
