{
  "identifier": "topic_tags",
  "scope_class": "global",
  "description": "Editorial topic tags",
  "prompt": "A list of short lowercase tags, no duplicates, at most 10.",
  "model": "gemini-3.5-flash",
  "notes": "This schema defines an array of up to 10 unique, lowercase, alphanumeric strings (including hyphens or underscores) with a maximum length of 50 characters to keep them short.",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
      "maxLength": 50,
      "pattern": "^[a-z0-9_-]+$",
      "type": "string"
    },
    "maxItems": 10,
    "type": "array",
    "uniqueItems": true
  },
  "suspected_gaps": [
    "pattern",
    "uniqueItems"
  ],
  "evaluation": {
    "samples": 1000,
    "generation_errors": 0,
    "invalid_samples": 0,
    "generation_error_examples": [],
    "invalid_examples": []
  }
}
