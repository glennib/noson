    "format": "uri",
    "pattern": "^https://",
    "type": "string"
  },
  "suspected_gaps": [
    "format:uri",
    "pattern"
  ],
  "evaluation": {
    "samples": 1000,
    "generation_errors": 0,
    "invalid_samples": 0,
    "generation_error_examples": [],
    "invalid_examples": []
  }
}
