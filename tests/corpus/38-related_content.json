{
  "identifier": "related_content",
  "scope_class": "global",
  "description": "Related content ids",
  "prompt": "1-20 unique content ids. Ids look like acme:article:12345.",
  "model": "gemini-3.5-flash",
  "notes": "This schema defines an array constrained to between 1 and 20 unique items. Each item is validated against a regular expression pattern matching the colon-separated content ID format.",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
      "pattern": "^[a-zA-Z0-9_-]+:[a-zA-Z0-9_-]+:[a-zA-Z0-9_-]+$",
      "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
  },
  "suspected_gaps": [
    "pattern",
    "uniqueItems"
  ],
  "evaluation": {
    "samples": 1000,
    "generation_errors": 0,
    "invalid_samples": 0,
    "generation_error_examples": [],
    "invalid_examples": []
  }
}
