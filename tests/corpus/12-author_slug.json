{
  "identifier": "author_slug",
  "scope_class": "global",
  "description": "Canonical author slug",
  "prompt": "Lowercase letters, digits and hyphens, like jane-doe-2.",
  "model": "gemini-3.5-flash",
  "notes": "The schema uses a regex pattern to enforce kebab-case format consisting of lowercase letters, digits, and single hyphens, preventing trailing/leading hyphens.",
