{
  "identifier": "gallery",
  "scope_class": "global",
  "description": "Photo gallery for the article",
  "prompt": "A list of image objects (url, alt). At least one image must be marked as the cover (a boolean cover flag).",
  "model": "gemini-3.5-flash",
  "notes": "The schema defines an array of image objects requiring 'url' and 'alt' properties. We use the 'contains' validator to enforce that at least one item in the array has 'cover' set to true.",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "contains": {
      "properties": {
        "cover": {
          "const": true
        }
      },
      "required": [
        "cover"
      ],
      "type": "object"
    },
    "items": {
      "properties": {
        "alt": {
          "description": "Alternative text for the photo.",
          "type": "string"
        },
        "cover": {
          "description": "Identifies if this photo is the cover image.",
          "type": "boolean"
        },
        "url": {
          "description": "The URL of the photo.",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "url",
        "alt"
      ],
      "type": "object"
    },
    "minItems": 1,
    "type": "array"
  },
  "suspected_gaps": [
    "contains",
    "format:uri"
  ],
